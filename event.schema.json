{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FSAMP Secure Event",
  "description": "Standard event definition for FSAMP platform file processing flow.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "description": "Unique identifier for the event (UUID format).",
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "description": "Trace ID used to track the request across microservices.",
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "description": "Event occurrence timestamp (ISO 8601 UTC).",
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "description": "Discriminator for the type of event action.",
      "type": "string",
      "enum": [
        "FILE_UPLOADED",
        "FILE_SCANNED",
        "ANALYSIS_COMPLETED",
        "PROCESSING_FAILED"
      ]
    },
    "fileMetadata": {
      "type": "object",
      "description": "Business metadata regarding the processed file.",
      "properties": {
        "originalFilename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "fileSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mimeType": {
          "type": "string",
          "example": "application/pdf"
        }
      },
      "required": [
        "originalFilename",
        "fileSizeBytes"
      ]
    },
    "storageLocation": {
      "type": "object",
      "description": "Pointer to the physical storage location (Claim-Check Pattern).",
      "properties": {
        "bucketName": {
          "type": "string",
          "minLength": 1
        },
        "objectKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucketName",
        "objectKey"
      ]
    },
    "securityContext": {
      "type": "object",
      "description": "Cryptographic metadata required for FIPS 140-3 compliance.",
      "properties": {
        "isEncrypted": {
          "type": "boolean",
          "default": true
        },
        "encryptionAlgorithm": {
          "type": "string",
          "enum": [
            "AES/GCM/NoPadding",
            "AES/CBC/PKCS5Padding"
          ],
          "description": "FIPS-compliant algorithm used for payload encryption."
        },
        "kmsKeyId": {
          "type": "string",
          "description": "ARN of the AWS KMS key used for envelope encryption.",
          "minLength": 1
        }
      },
      "required": [
        "isEncrypted"
      ]
    }
  },
  "required": [
    "eventId",
    "timestamp",
    "eventType",
    "fileMetadata",
    "storageLocation",
    "securityContext"
  ]
}